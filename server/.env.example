PORT=3000

# Required: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required: https://platform.openai.com (used only for speech-to-text/transcription)
OPENAI_API_KEY=

# Model used for the conversation itself. Haiku is fast/cheap and good enough
# for spoken small talk; switch to a Sonnet/Opus id for more nuanced tutoring.
CLAUDE_MODEL=claude-haiku-4-5-20251001

OPENAI_STT_MODEL=whisper-1

# Required: https://console.cloud.google.com — used for the agent's voice
# (text-to-speech). Pure pay-as-you-go, no subscription — like Anthropic/
# OpenAI (~$16 per 1M characters, 1M characters/month free).
GOOGLE_TTS_API_KEY=
# en-GB voices sound British. Full list: cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=en-GB-Neural2-B
GOOGLE_TTS_LANGUAGE_CODE=en-GB

# Optional, for later: ElevenLabs sounds more natural/realistic than Google's
# voices, but requires a paid monthly plan (not pure pay-as-you-go). Only
# needed if you switch server/src/routes/speak.js to import from
# lib/elevenlabs.js instead of lib/googletts.js.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Any long random string. The web app must send it back in the
# X-App-Secret header, otherwise requests are rejected. This stops a
# stranger who finds your server URL from burning your API credits.
# Generate one with: openssl rand -hex 32
APP_SHARED_SECRET=
