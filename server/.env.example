PORT=3000

# Required: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required: https://platform.openai.com (used only for speech-to-text/transcription)
OPENAI_API_KEY=

# Model used for the conversation itself. Haiku is fast/cheap and good enough
# for spoken small talk; switch to a Sonnet/Opus id for more nuanced tutoring.
CLAUDE_MODEL=claude-haiku-4-5-20251001

OPENAI_STT_MODEL=whisper-1

# Required: https://elevenlabs.io — used for the agent's voice (text-to-speech).
# OpenAI's TTS voices have no accent control, so this app uses ElevenLabs
# instead to get a real British accent.
ELEVENLABS_API_KEY=
# Go to elevenlabs.io -> Voice Library, filter by accent "British", pick a
# voice you like, and paste its Voice ID here (looked up per account — IDs
# aren't fixed across accounts/time, so always confirm in your own library).
ELEVENLABS_VOICE_ID=
# Flash is the fastest/cheapest model, good for a real-time back-and-forth.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Any long random string. The web app must send it back in the
# X-App-Secret header, otherwise requests are rejected. This stops a
# stranger who finds your server URL from burning your API credits.
# Generate one with: openssl rand -hex 32
APP_SHARED_SECRET=
